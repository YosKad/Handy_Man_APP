# HandyAI backend configuration.
# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------- runtime
ENVIRONMENT=local                  # local | test | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------- security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses to start with the development default below.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated first-party web origins. Never use "*".
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- datastores
DATABASE_URL=postgresql+asyncpg://handyai:handyai@localhost:5432/handyai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- ai providers
# fake = deterministic in-process fixtures. Default for local dev and CI:
# the whole pipeline works offline and costs nothing.
AI_PROVIDER=fake
AI_FALLBACK_PROVIDERS=              # e.g. anthropic,gemini
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_COST_CEILING_USD=1.00           # per request; exceeded -> job fails before the call
AI_VISION_MAX_IMAGES=8
AI_VISION_MAX_EDGE_PX=1568

OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_EMBEDDING_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------- storage
STORAGE_BACKEND=local              # local | s3 | supabase
STORAGE_LOCAL_PATH=.local_storage
STORAGE_SIGNED_URL_TTL_SECONDS=600
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# ---------------------------------------------------------------- media limits
MEDIA_MAX_IMAGE_BYTES=12582912     # 12 MB
MEDIA_MAX_VIDEO_BYTES=62914560     # 60 MB
MEDIA_RETENTION_MONTHS=24

# ---------------------------------------------------------------- jobs
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------- observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------- privacy
ACCOUNT_DELETION_GRACE_DAYS=30
CONSENT_VERSION=2026-08-01
